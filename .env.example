# Copy this file to ".env" next to the program or in the working directory.
# .env is gitignored — never commit real passwords.
# Already-set OS / Docker variables are not overwritten.
#
# Nested YAML fields use double underscore: auth.mode -> ONVIF_EMU_AUTH__MODE
# CLI flags still win over .env.

# Bind all interfaces (default). Use 127.0.0.1 for this PC only.
ONVIF_EMU_HOST=0.0.0.0
ONVIF_EMU_ONVIF_PORT=8080
ONVIF_EMU_NETWORK__RTSP_PORT=8554

# Advertised IP in ONVIF XAddr / RTSP URIs (empty = autodetect).
ONVIF_EMU_PUBLIC_HOST=
# Docker Compose helper (maps to the same idea):
# PUBLIC_HOST=192.168.1.50

ONVIF_EMU_AUTH__MODE=digest
ONVIF_EMU_AUTH__USERNAME=admin
ONVIF_EMU_AUTH__PASSWORD=admin

ONVIF_EMU_LANGUAGE=ru
ONVIF_EMU_GUI=true
ONVIF_EMU_DISCOVERY=true

ONVIF_EMU_LOGGING__LEVEL=INFO
# Empty = onvif-emulator.log next to the program
ONVIF_EMU_LOGGING__FILE=
