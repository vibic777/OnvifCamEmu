# Copy this file to .env.docker, set a strong password, then use:
# docker compose --env-file .env.docker up --build -d

# LAN address reported to ONVIF clients. Set this to the Docker host's LAN IP.
PUBLIC_HOST=192.168.1.50

# Published host/container ports. The same values configure the services inside.
BIND_ADDRESS=0.0.0.0
ONVIF_PORT=8080
RTSP_PORT=8554
ONVIF_DISCOVERY_PORT=3702
HLS_PORT=8888
WEBRTC_PORT=8889
# MediaMTX API stays private inside the container; the app uses this port internally.
MEDIAMTX_API_PORT=9997
# Host-side UDP ports; MediaMTX listens on the fixed container ports shown after the colon.
RTSP_RTP_UDP_PORT=8000
RTSP_RTCP_UDP_PORT=8001
WEBRTC_UDP_PORT=8189

# Host folders. Uploaded clips appear in VIDEO_HOST_DIR and are stored in /app/video.
CONFIG_HOST_DIR=./config
DATA_HOST_DIR=./data
VIDEO_HOST_DIR=./video
# Optional readonly folder for existing source clips; refer to them as /media/name.mp4.
MEDIA_HOST_DIR=./media
CONFIG_FILE=default.yaml
IMAGE_TAG=1.8.2
PYTHON_IMAGE=python:3.12-slim
MEDIAMTX_IMAGE=bluenviron/mediamtx:1.20.1

# Match the owner of CONFIG_HOST_DIR, DATA_HOST_DIR, VIDEO_HOST_DIR and MEDIA_HOST_DIR.
# On Linux: id -u ; id -g
PUID=1000
PGID=1000

# ONVIF/Digest and RTSP account. Replace this before exposing the service.
ONVIF_EMU_AUTH__MODE=digest
ONVIF_EMU_AUTH__USERNAME=admin
ONVIF_EMU_AUTH__PASSWORD=replace-this-with-a-long-random-password

# Any other supported application setting can be passed through as ONVIF_EMU_*.
# Examples:
# ONVIF_EMU_DISCOVERY=false
# ONVIF_EMU_DEVICE__NAME=Lab Camera
# ONVIF_EMU_LOGGING__LEVEL=INFO
